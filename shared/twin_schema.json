{
  "schema_version": "1.0.0",
  "refresh_interval_seconds": 300,
  "description": "Shared Cardiovascular Digital Twin State Vector schema used by FastAPI backend and React TypeScript frontend.",
  "fields": {
    "heart_rate": {
      "label": "Heart Rate",
      "category": "vitals",
      "unit": "bpm",
      "type": "float",
      "physiological_min": 30.0,
      "physiological_max": 220.0,
      "normal_min": 60.0,
      "normal_max": 100.0,
      "caution_low": 50.0,
      "caution_high": 120.0,
      "critical_low": 45.0,
      "critical_high": 130.0,
      "default": 72.0,
      "accepted_units": ["bpm"]
    },
    "systolic_bp": {
      "label": "Systolic Blood Pressure",
      "category": "vitals",
      "unit": "mmHg",
      "type": "float",
      "physiological_min": 60.0,
      "physiological_max": 250.0,
      "normal_min": 90.0,
      "normal_max": 120.0,
      "caution_low": 85.0,
      "caution_high": 139.0,
      "critical_low": 80.0,
      "critical_high": 140.0,
      "default": 122.0,
      "accepted_units": ["mmHg", "kPa"]
    },
    "diastolic_bp": {
      "label": "Diastolic Blood Pressure",
      "category": "vitals",
      "unit": "mmHg",
      "type": "float",
      "physiological_min": 35.0,
      "physiological_max": 150.0,
      "normal_min": 60.0,
      "normal_max": 80.0,
      "caution_low": 55.0,
      "caution_high": 89.0,
      "critical_low": 50.0,
      "critical_high": 90.0,
      "default": 78.0,
      "accepted_units": ["mmHg", "kPa"]
    },
    "ejection_fraction": {
      "label": "Left Ventricular Ejection Fraction",
      "category": "hemodynamics",
      "unit": "%",
      "type": "float",
      "physiological_min": 10.0,
      "physiological_max": 80.0,
      "normal_min": 55.0,
      "normal_max": 70.0,
      "caution_low": 40.0,
      "caution_high": 75.0,
      "critical_low": 35.0,
      "critical_high": 78.0,
      "default": 58.0,
      "accepted_units": ["%"]
    },
    "cardiac_output": {
      "label": "Cardiac Output (Derived)",
      "category": "hemodynamics",
      "unit": "L/min",
      "type": "float",
      "derived": true,
      "physiological_min": 1.5,
      "physiological_max": 12.0,
      "normal_min": 4.0,
      "normal_max": 8.0,
      "caution_low": 3.2,
      "caution_high": 9.0,
      "critical_low": 2.8,
      "critical_high": 10.0,
      "default": 5.2,
      "accepted_units": ["L/min"]
    },
    "o2_saturation": {
      "label": "SpO2 (Oxygen Saturation)",
      "category": "vitals",
      "unit": "%",
      "type": "float",
      "physiological_min": 60.0,
      "physiological_max": 100.0,
      "normal_min": 95.0,
      "normal_max": 100.0,
      "caution_low": 91.0,
      "caution_high": 100.0,
      "critical_low": 90.0,
      "critical_high": 100.0,
      "default": 98.0,
      "accepted_units": ["%"]
    },
    "ldl": {
      "label": "LDL Cholesterol",
      "category": "labs",
      "unit": "mg/dL",
      "type": "float",
      "physiological_min": 20.0,
      "physiological_max": 400.0,
      "normal_min": 0.0,
      "normal_max": 99.9,
      "caution_low": 0.0,
      "caution_high": 159.0,
      "critical_low": 0.0,
      "critical_high": 160.0,
      "default": 115.0,
      "accepted_units": ["mg/dL", "mmol/L"]
    },
    "hdl": {
      "label": "HDL Cholesterol",
      "category": "labs",
      "unit": "mg/dL",
      "type": "float",
      "physiological_min": 15.0,
      "physiological_max": 130.0,
      "normal_min": 45.0,
      "normal_max": 120.0,
      "caution_low": 35.0,
      "caution_high": 120.0,
      "critical_low": 30.0,
      "critical_high": 125.0,
      "default": 48.0,
      "accepted_units": ["mg/dL", "mmol/L"]
    },
    "triglycerides": {
      "label": "Triglycerides",
      "category": "labs",
      "unit": "mg/dL",
      "type": "float",
      "physiological_min": 30.0,
      "physiological_max": 1200.0,
      "normal_min": 0.0,
      "normal_max": 149.9,
      "caution_low": 0.0,
      "caution_high": 199.0,
      "critical_low": 0.0,
      "critical_high": 200.0,
      "default": 140.0,
      "accepted_units": ["mg/dL", "mmol/L"]
    },
    "bnp": {
      "label": "B-Type Natriuretic Peptide (BNP)",
      "category": "biomarkers",
      "unit": "pg/mL",
      "type": "float",
      "physiological_min": 5.0,
      "physiological_max": 5000.0,
      "normal_min": 0.0,
      "normal_max": 99.9,
      "caution_low": 0.0,
      "caution_high": 400.0,
      "critical_low": 0.0,
      "critical_high": 401.0,
      "default": 65.0,
      "accepted_units": ["pg/mL", "ng/L"]
    },
    "troponin": {
      "label": "Cardiac Troponin I",
      "category": "biomarkers",
      "unit": "ng/mL",
      "type": "float",
      "physiological_min": 0.001,
      "physiological_max": 50.0,
      "normal_min": 0.0,
      "normal_max": 0.039,
      "caution_low": 0.0,
      "caution_high": 0.1,
      "critical_low": 0.0,
      "critical_high": 0.101,
      "default": 0.015,
      "accepted_units": ["ng/mL", "ng/L", "ug/L"]
    },
    "potassium": {
      "label": "Serum Potassium (K+)",
      "category": "labs",
      "unit": "mEq/L",
      "type": "float",
      "physiological_min": 2.0,
      "physiological_max": 7.5,
      "normal_min": 3.5,
      "normal_max": 5.0,
      "caution_low": 3.1,
      "caution_high": 5.4,
      "critical_low": 3.0,
      "critical_high": 5.5,
      "default": 4.2,
      "accepted_units": ["mEq/L", "mmol/L"]
    },
    "creatinine": {
      "label": "Serum Creatinine",
      "category": "labs",
      "unit": "mg/dL",
      "type": "float",
      "physiological_min": 0.3,
      "physiological_max": 15.0,
      "normal_min": 0.6,
      "normal_max": 1.3,
      "caution_low": 0.5,
      "caution_high": 2.0,
      "critical_low": 0.4,
      "critical_high": 2.1,
      "default": 1.0,
      "accepted_units": ["mg/dL", "umol/L"]
    },
    "egfr": {
      "label": "Estimated GFR (CKD-EPI)",
      "category": "labs",
      "unit": "mL/min/1.73m2",
      "type": "float",
      "derived": true,
      "physiological_min": 5.0,
      "physiological_max": 140.0,
      "normal_min": 90.0,
      "normal_max": 140.0,
      "caution_low": 45.0,
      "caution_high": 140.0,
      "critical_low": 30.0,
      "critical_high": 140.0,
      "default": 88.0,
      "accepted_units": ["mL/min/1.73m2"]
    },
    "age": {
      "label": "Age",
      "category": "demographics",
      "unit": "years",
      "type": "int",
      "physiological_min": 18,
      "physiological_max": 110,
      "default": 58
    },
    "sex": {
      "label": "Biological Sex",
      "category": "demographics",
      "unit": "category",
      "type": "enum",
      "values": ["M", "F"],
      "default": "M"
    },
    "bmi": {
      "label": "Body Mass Index (BMI)",
      "category": "demographics",
      "unit": "kg/m2",
      "type": "float",
      "physiological_min": 12.0,
      "physiological_max": 65.0,
      "normal_min": 18.5,
      "normal_max": 24.9,
      "caution_low": 17.0,
      "caution_high": 29.9,
      "critical_low": 16.0,
      "critical_high": 35.0,
      "default": 27.4,
      "accepted_units": ["kg/m2"]
    },
    "smoking_status": {
      "label": "Smoking Status",
      "category": "demographics",
      "unit": "category",
      "type": "enum",
      "values": ["never", "former", "current"],
      "default": "former"
    },
    "diabetes_status": {
      "label": "Diabetes Mellitus",
      "category": "demographics",
      "unit": "boolean",
      "type": "bool",
      "default": false
    },
    "family_history": {
      "label": "Family History of Premature CAD",
      "category": "demographics",
      "unit": "boolean",
      "type": "bool",
      "default": false
    }
  },
  "medications": {
    "metoprolol": {
      "class": "Beta-blocker",
      "generic_name": "Metoprolol",
      "unit": "mg/day",
      "min_dose": 0.0,
      "max_dose": 200.0,
      "step": 12.5,
      "onset": "fast",
      "primary_effects": "Decreases heart rate, contractility, and blood pressure",
      "risk_flags": ["Bradycardia at high dose (HR < 55 bpm)"]
    },
    "lisinopril": {
      "class": "ACE inhibitor",
      "generic_name": "Lisinopril",
      "unit": "mg/day",
      "min_dose": 0.0,
      "max_dose": 40.0,
      "step": 2.5,
      "onset": "slow",
      "primary_effects": "Lowers BP/afterload, improves LV remodeling (weeks), raises K+, may reduce eGFR",
      "risk_flags": ["Hyperkalemia", "Renal function impairment"]
    },
    "furosemide": {
      "class": "Loop diuretic",
      "generic_name": "Furosemide",
      "unit": "mg/day",
      "min_dose": 0.0,
      "max_dose": 80.0,
      "step": 10.0,
      "onset": "fast",
      "primary_effects": "Reduces preload, BP, BNP, and serum potassium",
      "risk_flags": ["Hypokalemia", "Dehydration / hypotension"]
    },
    "atorvastatin": {
      "class": "Statin",
      "generic_name": "Atorvastatin",
      "unit": "mg/day",
      "min_dose": 0.0,
      "max_dose": 80.0,
      "step": 10.0,
      "onset": "slow",
      "primary_effects": "Reduces LDL over weeks, modestly raises HDL",
      "risk_flags": ["High-intensity myopathy / LFT monitoring at 80 mg/day"]
    },
    "amlodipine": {
      "class": "Calcium channel blocker",
      "generic_name": "Amlodipine",
      "unit": "mg/day",
      "min_dose": 0.0,
      "max_dose": 10.0,
      "step": 1.25,
      "onset": "fast",
      "primary_effects": "Lowers BP via arterial vasodilation",
      "risk_flags": ["Peripheral edema", "Additive hypotension"]
    },
    "digoxin": {
      "class": "Cardiac glycoside",
      "generic_name": "Digoxin",
      "unit": "mg/day",
      "min_dose": 0.0,
      "max_dose": 0.25,
      "step": 0.0625,
      "onset": "fast",
      "primary_effects": "Increases myocardial contractility (EF) and slows AV conduction",
      "risk_flags": ["Narrow therapeutic index: toxicity risk with low eGFR or hypokalemia"]
    },
    "isosorbide_mononitrate": {
      "class": "Nitrate",
      "generic_name": "Isosorbide mononitrate",
      "unit": "mg/day",
      "min_dose": 0.0,
      "max_dose": 120.0,
      "step": 15.0,
      "onset": "fast",
      "primary_effects": "Venodilation and preload reduction",
      "risk_flags": ["Hypotension risk when combined with other vasodilators"]
    },
    "aspirin": {
      "class": "Antiplatelet",
      "generic_name": "Aspirin",
      "unit": "mg/day",
      "min_dose": 0.0,
      "max_dose": 325.0,
      "step": 25.0,
      "onset": "fast",
      "primary_effects": "Inhibits platelet aggregation, reduces thrombotic MACE risk",
      "risk_flags": ["GI/systemic bleeding risk at high dose (>162 mg/day)"]
    }
  }
}
